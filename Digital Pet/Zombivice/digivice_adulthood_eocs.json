{
  "type": "effect_on_condition",
  "id": "EOC_DIGIVICE_INIT_ADULT",
  "effect": [
    { "math": [ "n_pet_stage = 5" ] },
      { "give_achievement": "achievement_digivice_adult" },
    { "math": [ "n_pet_death_timer = 0" ] },
    { "math": [ "n_pet_evolve_progress = 0" ] },
    { "math": [ "global_young_adult_evo_count = global_young_adult_evo_count + 1" ] },
    { "math": [ "global_adult_stage_reached = 1" ] },
    {
      "if": { "math": [ "n_care_mistakes <= 3" ] },
      "then": { "math": [ "global_low_care_mistakes_adult = 1" ] }
    },
    {
      "if": { "math": [ "n_care_mistakes == 0" ] },
      "then": { "give_achievement": "achievement_digivice_perfect_care" }
    },
    { "u_message": "Your digital pet has reached its adult form!", "type": "good" }
  ]
},
