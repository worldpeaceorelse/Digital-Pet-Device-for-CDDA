  {
    "type": "talk_topic",
    "id": "DIGIVICE_TOURNAMENT_START",
    "dynamic_line": "Welcome to the TOURNAMENT!\nZPoints: <u_val:zpoints>\n\nCurrent Progress: Level <u_val:tournament_level_str>/100\nWins: <u_val:tournament_wins>  Losses: <u_val:tournament_losses>\nChampionships: <u_val:tournament_championships>",
    "responses": [
      {
        "text": "Resume tournament",
        "topic": "DIGIVICE_TOURNAMENT_START",
        "condition": {
          "and": [
            {
              "math": [
                "u_tournament_level > 1"
              ]
            },
            {
              "math": [
                "u_tournament_level <= 100"
              ]
            }
          ]
        },
        "effect": {
          "run_eocs": "EOC_DIGIVICE_TOURNAMENT_NEXT_ROUND"
        }
      },
      {
        "text": "Start new tournament",
        "topic": "DIGIVICE_TOURNAMENT_START",
        "effect": {
          "run_eocs": "EOC_DIGIVICE_TOURNAMENT_INIT"
        }
      },
      {
        "text": "I'm done for now",
        "topic": "TALK_DONE"
