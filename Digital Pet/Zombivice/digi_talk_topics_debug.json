[
  {
    "type": "talk_topic",
    "id": "DIGIVICE_MAIN_MENU",
    "dynamic_line": "<u_val:pet_name_display> is <u_val:pet_idle_action>\n\nAge: <u_val:pet_age_days>d <u_val:pet_age_hours>h\nHunger: <u_val:pet_hunger_desc> (<u_val:pet_hunger_num>/100)\nHappiness: <u_val:pet_happy_desc> (<u_val:pet_happy_num>/100)\nWeight: <u_val:pet_weight>g\nStamina: <u_val:pet_stamina>/<u_val:pet_max_stamina>\nMess: <u_val:pet_mess_count>/4\nSleep: <u_val:pet_sleep_desc>\nHealth: <u_val:pet_virus_desc>\nZPoints: <u_val:zpoints>",
    "responses": [
      {
        "text": "Feed your monster!",
        "topic": "DIGIVICE_MAIN_MENU",
        "effect": {
          "run_eocs": "EOC_DIGIVICE_FEED"
        },
        "condition": {
          "math": [
            "u_pet_sleeping == 0"
          ]
        }
      },
      {
        "text": "Play with your monster!",
        "topic": "DIGIVICE_MAIN_MENU",
        "effect": {
          "run_eocs": "EOC_DIGIVICE_PLAY"
        },
        "condition": {
          "math": [
            "u_pet_sleeping == 0"
          ]
        }
      },
      {
        "text": "Scold your monster!",
        "topic": "DIGIVICE_MAIN_MENU",
        "effect": {
          "run_eocs": "EOC_DIGIVICE_SCOLD"
        },
        "condition": {
          "math": [
            "u_pet_sleeping == 0"
          ]
        }
      },
      {
        "text": "Training menu...",
        "topic": "DIGIVICE_TRAIN_MENU",
        "condition": {
          "math": [
            "u_pet_sleeping == 0"
          ]
        }
      },
      {
        "text": "Clean up messes!",
        "topic": "DIGIVICE_MAIN_MENU",
        "effect": {
          "run_eocs": "EOC_DIGIVICE_FLUSH"
        },
        "condition": {
          "math": [
            "u_pet_sleeping == 0"
          ]
        }
      },
      {
        "text": "Battle menu...",
        "topic": "DIGIVICE_BATTLE_MENU",
        "condition": {
          "and": [
            {
              "math": [
                "u_pet_sleeping == 0"
              ]
            },
            {
              "math": [
                "u_pet_quarantined == 0"
              ]
            }
          ]
        }
      },
      {
        "text": "Put pet to bed",
        "topic": "TALK_DONE",
        "effect": {
          "run_eocs": "EOC_DIGIVICE_PUT_TO_SLEEP"
        },
        "condition": {
          "and": [
            {
              "math": [
                "u_pet_sleeping == 0"
              ]
            },
            {
              "math": [
                "u_pet_tired == 1"
              ]
            }
          ]
        }
      },
      {
        "text": "Wake pet up",
        "topic": "TALK_DONE",
        "effect": {
          "run_eocs": "EOC_DIGIVICE_WAKE_UP"
        },
        "condition": {
          "math": [
            "u_pet_sleeping == 1"
          ]
        }
      },
      {
        "text": "Quarantine pet",
        "topic": "TALK_DONE",
        "effect": {
          "run_eocs": "EOC_DIGIVICE_QUARANTINE"
        },
        "condition": {
          "and": [
            {
              "math": [
                "u_pet_sleeping == 0"
              ]
            },
            {
              "math": [
                "u_pet_quarantined == 0"
              ]
            },
            {
              "math": [
                "u_infected == 1"
              ]
            }
          ]
        }
      },
      {
        "text": "Release from quarantine",
        "topic": "TALK_DONE",
        "effect": {
          "run_eocs": "EOC_DIGIVICE_UNQUARANTINE"
        },
        "condition": {
          "math": [
            "u_pet_quarantined == 1"
          ]
        }
      },
      {
        "text": "Open compendium",
        "topic": "DIGIVICE_COMPENDIUM"
      },
      {
        "text": "Never mind",
        "topic": "TALK_DONE"
      }
    ]
  },
  {
