  {
    "type": "effect_on_condition",
    "id": "EOC_DIGIVICE_GET_HUNGER_STATUS",
    "effect": [
      { "math": [ "u_pet_hunger_num = n_pet_hunger" ] },
      {
        "if": { "math": [ "n_pet_hunger >= 90" ] },
        "then": { "set_string_var": "Well fed!", "target_var": { "u_val": "pet_hunger_desc" } }
      },
      {
        "if": {
          "and": [
            { "math": [ "n_pet_hunger >= 76" ] },
            { "math": [ "n_pet_hunger < 90" ] }
          ]
        },
        "then": { "set_string_var": "Satisfied", "target_var": { "u_val": "pet_hunger_desc" } }
      },
      {
        "if": {
          "and": [
            { "math": [ "n_pet_hunger >= 51" ] },
            { "math": [ "n_pet_hunger < 76" ] }
          ]
        },
        "then": { "set_string_var": "Peckish", "target_var": { "u_val": "pet_hunger_desc" } }
      },
      {
        "if": {
          "and": [
            { "math": [ "n_pet_hunger >= 21" ] },
            { "math": [ "n_pet_hunger < 51" ] }
          ]
        },
        "then": { "set_string_var": "Starving", "target_var": { "u_val": "pet_hunger_desc" } }
      },
      {
        "if": { "math": [ "n_pet_hunger < 21" ] },
        "then": { "set_string_var": "Near death", "target_var": { "u_val": "pet_hunger_desc" } }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_DIGIVICE_GET_HAPPY_STATUS",
    "effect": [
      { "math": [ "u_pet_happy_num = n_pet_happiness" ] },
      {
        "if": { "math": [ "n_pet_happiness >= 90" ] },
        "then": { "set_string_var": "Ecstatic!", "target_var": { "u_val": "pet_happy_desc" } }
      },
      {
        "if": {
          "and": [
            { "math": [ "n_pet_happiness >= 76" ] },
            { "math": [ "n_pet_happiness < 90" ] }
          ]
        },
        "then": { "set_string_var": "Happy", "target_var": { "u_val": "pet_happy_desc" } }
      },
      {
        "if": {
          "and": [
            { "math": [ "n_pet_happiness >= 51" ] },
            { "math": [ "n_pet_happiness < 76" ] }
          ]
        },
        "then": { "set_string_var": "Content", "target_var": { "u_val": "pet_happy_desc" } }
      },
      {
        "if": {
          "and": [
            { "math": [ "n_pet_happiness >= 21" ] },
            { "math": [ "n_pet_happiness < 51" ] }
          ]
        },
        "then": { "set_string_var": "Lonely", "target_var": { "u_val": "pet_happy_desc" } }
      },
      {
        "if": { "math": [ "n_pet_happiness < 21" ] },
        "then": { "set_string_var": "Miserable", "target_var": { "u_val": "pet_happy_desc" } }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_DIGIVICE_GET_SLEEP_STATUS",
    "effect": [
      { "math": [ "u_sleep_timer = n_sleep_timer" ] },
      { "math": [ "u_awake_timer = n_awake_timer" ] },
      { "math": [ "u_pet_tired = n_pet_tired" ] },
      { "set_string_var": "Awake", "target_var": { "u_val": "pet_sleep_desc" } },
      {
        "if": { "math": [ "n_pet_sleeping == 1" ] },
        "then": { "set_string_var": "Sleeping", "target_var": { "u_val": "pet_sleep_desc" } }
      },
      {
        "if": { "math": [ "n_pet_tired == 1" ] },
        "then": [
          { "set_string_var": "Awake (Tired!)", "target_var": { "u_val": "pet_sleep_desc" } }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_DIGIVICE_GET_VIRUS_STATUS",
    "effect": [
      { "math": [ "u_virus_progress = n_virus_progress" ] },
      { "math": [ "u_infected = n_infected" ] },
      { "set_string_var": "Healthy", "target_var": { "u_val": "pet_virus_desc" } },
      {
        "if": { "math": [ "n_virus_progress > 0" ] },
        "then": { "set_string_var": "At risk", "target_var": { "u_val": "pet_virus_desc" } }
      },
      {
        "if": { "math": [ "n_virus_progress >= 50" ] },
        "then": { "set_string_var": "High risk", "target_var": { "u_val": "pet_virus_desc" } }
      },
      {
        "if": { "math": [ "n_infected == 1" ] },
        "then": { "set_string_var": "INFECTED!", "target_var": { "u_val": "pet_virus_desc" } }
      }
    ]
  },
  {
  "type": "effect_on_condition",
  "id": "EOC_DIGIVICE_TICK_ITEM",
  "effect": [
    { "math": [ "n_pet_age = n_pet_age + 1" ] },
    {
      "if": { "math": [ "n_pet_age >= 24" ] },
      "then": { "math": [ "global_age_ge_24 = 1" ] }
    },
    {
      "if": { "math": [ "n_pet_age >= 48" ] },
      "then": { "math": [ "global_max_age_ge_48 = 1" ] }
    },
    {
      "if": { "math": [ "n_pet_sleeping == 1" ] },
      "then": [
        { "math": [ "n_pet_hunger = n_pet_hunger - 2" ] },
        { "math": [ "n_pet_happiness = n_pet_happiness - 1" ] },
        { "math": [ "n_stamina = min(n_stamina + 30, n_max_stamina)" ] },
        { "math": [ "n_sleep_timer = n_sleep_timer - 1" ] },
        {
          "if": { "math": [ "n_sleep_timer <= 0" ] },
          "then": [
            { "math": [ "n_pet_sleeping = 0" ] },
            { "math": [ "n_awake_timer = 0" ] },
            { "math": [ "n_pet_tired = 0" ] },
            { "u_message": "Your digital pet wakes up naturally, fully rested!", "type": "good", "popup": true }
          ]
        }
      ],
      "else": [
        { "math": [ "n_pet_hunger = n_pet_hunger - 10" ] },
        { "math": [ "n_pet_happiness = n_pet_happiness - 5" ] },
        { "math": [ "n_stamina = min(n_stamina + 10, n_max_stamina)" ] },
        { "math": [ "n_awake_timer = n_awake_timer + 1" ] },
        {
          "if": { "and": [ { "math": [ "n_awake_timer >= 12" ] }, { "math": [ "n_pet_tired == 0" ] } ] },
          "then": [
            { "math": [ "n_pet_tired = 1" ] },
            { "math": [ "n_tired_timer = 0" ] },
            { "u_message": "<color_yellow>BEEP! Your digital pet is tired and needs sleep!</color>", "type": "bad", "popup": true }
          ]
        },
        {
          "if": { "math": [ "n_pet_tired == 1" ] },
          "then": { "math": [ "n_tired_timer = n_tired_timer + 1" ] }
        }
      ]
    },
    {
      "if": { "and": [ { "math": [ "n_pet_sleeping == 0" ] }, { "math": [ "n_tired_timer >= 2" ] } ] },
      "then": [
        { "math": [ "n_pet_sleeping = 1" ] },
        { "math": [ "n_sleep_timer = 6" ] },
        { "math": [ "n_pet_tired = 0" ] },
        { "math": [ "n_awake_timer = 0" ] },
        { "math": [ "n_tired_timer = 0" ] },
        { "u_message": "Your pet was so tired it fell asleep on its own!", "type": "bad", "popup": true }
      ]
    },
    { "math": [ "n_pet_hunger = clamp(n_pet_hunger, 0, 100)" ] },
    { "math": [ "n_pet_happiness = clamp(n_pet_happiness, 0, 100)" ] },
    {
      "if": { "math": [ "n_pet_happiness >= 100" ] },
      "then": { "math": [ "global_reached_happiness_100 = 1" ] }
    },

    { "math": [ "n_potty_timer = n_potty_timer - 1" ] },
    {
      "if": { "math": [ "n_potty_timer <= 0" ] },
      "then": [
        { "math": [ "n_mess_count = n_mess_count + 1" ] },
{ "math": [ "n_hunger_mistake_timer = 0" ] },
      { "math": [ "n_happy_mistake_timer = 0" ] },
      { "math": [ "n_potty_timer = 2" ] },
        {
          "if": { "math": [ "n_mess_count > 4" ] },
          "then": [
            { "math": [ "n_care_mistakes = n_care_mistakes + 1" ] },
            { "math": [ "n_mess_count = 4" ] }
          ]
        }
      ]
    },

    {
      "if": { "math": [ "n_pet_hunger < 20" ] },
      "then": [
        { "math": [ "n_hunger_mistake_timer = n_hunger_mistake_timer - 1" ] },
        {
          "if": { "math": [ "n_hunger_mistake_timer <= 0" ] },
          "then": [
            { "math": [ "n_care_mistakes = n_care_mistakes + 1" ] },
            { "math": [ "n_hunger_mistake_timer = 3" ] }
          ]
        }
      ],
      "else": { "math": [ "n_hunger_mistake_timer = 0" ] }
    },
    {
      "if": { "math": [ "n_pet_happiness < 20" ] },
      "then": [
        { "math": [ "n_happy_mistake_timer = n_happy_mistake_timer - 1" ] },
        {
          "if": { "math": [ "n_happy_mistake_timer <= 0" ] },
          "then": [
            { "math": [ "n_care_mistakes = n_care_mistakes + 1" ] },
            { "math": [ "n_happy_mistake_timer = 3" ] }
          ]
        }
      ],
      "else": { "math": [ "n_happy_mistake_timer = 0" ] }
    },

    {
      "if": {
        "and": [
          { "math": [ "n_pet_hunger < 10" ] },
          { "math": [ "n_pet_happiness < 10" ] }
        ]
      },
      "then": { "math": [ "n_pet_death_timer = n_pet_death_timer + 1" ] },
      "else": { "math": [ "n_pet_death_timer = 0" ] }
    },
    { "math": [ "n_pet_death_timer = min(n_pet_death_timer, 24)" ] },
    {
      "if": { "math": [ "n_pet_death_timer >= 24" ] },
      "then": [
        { "u_message": "Your digital pet has died from days of neglect...", "type": "bad" },
        { "math": [ "global_pet_has_died = 1" ] },
        { "transform_item": "vpetmonster01_egg" }
      ]
    },

    {
      "if": { "math": [ "n_pet_quarantined == 0" ] },
      "then": [
        {
          "if": {
            "or": [
              { "math": [ "n_pet_hunger < 20" ] },
              { "math": [ "n_pet_happiness < 20" ] }
            ]
          },
          "then": { "math": [ "n_virus_progress = n_virus_progress + 1" ] }
        },
        { "math": [ "n_virus_progress = min(n_virus_progress, 100)" ] },
        {
          "if": { "math": [ "n_virus_progress >= 100" ] },
          "then": { "math": [ "n_infected = 1" ] }
        }
      ]
    },
    {
      "if": { "math": [ "n_pet_quarantined == 1" ] },
      "then": [
        { "math": [ "n_virus_progress = max(n_virus_progress - 5, 0)" ] },
        {
      "if": { "math": [ "n_virus_progress <= 0" ] },
      "then": [
        { "math": [ "n_infected = 0" ] },
        { "math": [ "global_infection_recovered = 1" ] }
      ]
        }
      ]
    },

    { "run_eocs": "EOC_DIGIVICE_CHECK_EVOLVE_BRANCH" },
    { "run_eocs": "EOC_DIGIVICE_MEGA_CHECK_EVOLVE_BRANCH" }
  ]
},
