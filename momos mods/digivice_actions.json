  {
    "type": "effect_on_condition",
    "id": "EOC_DIGIVICE_SCOLD",
    "effect": [
      {
        "u_run_inv_eocs": "all",
        "search_data": [
          {
            "condition": {
              "math": [
                "n_pet_uid == u_selected_pet_uid"
              ]
            }
          }
        ],
        "true_eocs": [
          {
            "id": "EOC_DIGIVICE_SCOLD_ITEM",
            "effect": [
              {
                "math": [
                  "n_pet_happiness = n_pet_happiness - 5"
                ]
              },
              {
                "math": [
                  "n_pet_happiness = clamp(n_pet_happiness, 0, 100)"
                ]
              },
              {
                "math": [
                  "u_pet_happy_num = n_pet_happiness"
                ]
              },
              {
                "if": {
                  "math": [
                    "n_pet_happiness >= 90"
                  ]
                },
                "then": {
                  "set_string_var": "Ecstatic!",
                  "target_var": {
                    "u_val": "pet_happy_desc"
                  }
                },
                "else": {
                  "if": {
                    "math": [
                      "n_pet_happiness >= 76"
                    ]
                  },
                  "then": {
                    "set_string_var": "Happy",
                    "target_var": {
                      "u_val": "pet_happy_desc"
                    }
                  },
                  "else": {
                    "if": {
                      "math": [
                        "n_pet_happiness >= 51"
                      ]
                    },
                    "then": {
                      "set_string_var": "Content",
                      "target_var": {
                        "u_val": "pet_happy_desc"
                      }
                    },
                    "else": {
                      "if": {
                        "math": [
                          "n_pet_happiness >= 21"
                        ]
                      },
                      "then": {
                        "set_string_var": "Lonely",
                        "target_var": {
                          "u_val": "pet_happy_desc"
                        }
                      },
                      "else": {
                        "set_string_var": "Miserable",
                        "target_var": {
                          "u_val": "pet_happy_desc"
                        }
                      }
                    }
                  }
                }
              },
              {
                "u_message": "You scold your digital pet. It looks sad now...",
                "type": "bad"
              }
            ]
          }
        ]
      }
    ]
  },
