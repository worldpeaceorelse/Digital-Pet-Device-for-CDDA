  {
    "type": "effect_on_condition",
    "id": "EOC_DIGIVICE_GIVE_HATCH_ACHIEVEMENT",
    "effect": [
      {
        "math": [
          "u_total_hatches = u_total_hatches + 1"
        ]
      },
      {
        "if": {
          "math": [
            "u_total_hatches == 1"
          ]
        },
        "then": {
          "give_achievement": "achievement_digivice_first_hatch"
        }
      },
      {
