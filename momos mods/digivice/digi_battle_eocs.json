  {
    "type": "effect_on_condition",
    "id": "EOC_DIGIVICE_BATTLE_RESOLVE",
    "effect": [
      {
        "set_string_var": "The battle begins!",
        "target_var": { "u_val": "battle_msg" }
      },
      {
        "set_string_var": "Your monster faces <u_val:battle_difficulty> opponent!",
        "target_var": { "u_val": "battle_msg" },
        "parse_tags": true
      },
      { "math": [ "u_battle_score = 0" ] },
      { "math": [ "u_battle_opponent_score = 0" ] },
      {
        "if": { "math": [ "u_pet_atk > u_battle_opponent_atk" ] },
        "then": { "math": [ "u_battle_score = u_battle_score + 1" ] },
        "else": {
          "if": { "math": [ "u_pet_atk < u_battle_opponent_atk" ] },
          "then": { "math": [ "u_battle_opponent_score = u_battle_opponent_score + 1" ] }
        }
      },
      {
        "if": { "math": [ "u_pet_def > u_battle_opponent_def" ] },
        "then": { "math": [ "u_battle_score = u_battle_score + 1" ] },
        "else": {
          "if": { "math": [ "u_pet_def < u_battle_opponent_def" ] },
          "then": { "math": [ "u_battle_opponent_score = u_battle_opponent_score + 1" ] }
        }
      },
      {
        "if": { "math": [ "u_pet_int > u_battle_opponent_int" ] },
        "then": { "math": [ "u_battle_score = u_battle_score + 1" ] },
        "else": {
          "if": { "math": [ "u_pet_int < u_battle_opponent_int" ] },
          "then": { "math": [ "u_battle_opponent_score = u_battle_opponent_score + 1" ] }
        }
      },
      {
        "if": { "math": [ "u_pet_agi > u_battle_opponent_agi" ] },
        "then": { "math": [ "u_battle_score = u_battle_score + 1" ] },
        "else": {
          "if": { "math": [ "u_pet_agi < u_battle_opponent_agi" ] },
          "then": { "math": [ "u_battle_opponent_score = u_battle_opponent_score + 1" ] }
        }
      },
      {
        "if": { "math": [ "u_pet_luck > u_battle_opponent_luck" ] },
        "then": { "math": [ "u_battle_score = u_battle_score + 1" ] },
        "else": {
          "if": { "math": [ "u_pet_luck < u_battle_opponent_luck" ] },
          "then": { "math": [ "u_battle_opponent_score = u_battle_opponent_score + 1" ] }
        }
      },
      { "math": [ "u_battle_chance = (u_battle_score * 20) + 10" ] },
      { "math": [ "u_battle_roll = rand(100)" ] },
      {
        "if": {
          "or": [
            { "math": [ "u_battle_roll < u_battle_chance" ] },
            { "math": [ "u_battle_roll >= 95" ] }
          ]
        },
        "then": [
          { "set_string_var": "VICTORY!", "target_var": { "u_val": "battle_result" } },
          { "set_string_var": "Your monster wins the battle!", "target_var": { "u_val": "battle_msg" } },
          { "math": [ "n_battle_loss_streak = 0" ] },
          {
            "u_run_inv_eocs": "all",
            "search_data": [
              { "condition": { "math": [ "n_pet_uid == u_selected_pet_uid" ] } }
            ],
            "true_eocs": [
              {
                "id": "EOC_DIGIVICE_BATTLE_STATS_INCREASE",
                "effect": [
                  { "math": [ "n_pet_atk = min(n_pet_atk + rand(3), 99)" ] },
                  { "math": [ "n_pet_def = min(n_pet_def + rand(3), 99)" ] },
                  { "math": [ "n_pet_int = min(n_pet_int + rand(3), 99)" ] },
                  { "math": [ "n_pet_agi = min(n_pet_agi + rand(3), 99)" ] },
                  { "math": [ "n_pet_luck = min(n_pet_luck + rand(3), 99)" ] },
                  { "math": [ "u_pet_atk = n_pet_atk" ] },
                  { "math": [ "u_pet_def = n_pet_def" ] },
                  { "math": [ "u_pet_int = n_pet_int" ] },
                  { "math": [ "u_pet_agi = n_pet_agi" ] },
                  { "math": [ "u_pet_luck = n_pet_luck" ] },
                  { "u_message": "Your monster's stats have increased! (0-2 each)", "type": "good" },
                  { "math": [ "n_pet_happiness = min(n_pet_happiness + 10, 100)" ] },
                  { "math": [ "n_pet_evolve_progress = n_pet_evolve_progress + 10" ] },
                  { "math": [ "u_pet_happiness = n_pet_happiness" ] },
                  { "math": [ "u_pet_evolve_progress = n_pet_evolve_progress" ] },
                  { "run_eocs": "EOC_DIGIVICE_GET_HAPPY_STATUS" }
                ]
              }
            ]
          },
          { "run_eocs": "EOC_DIGIVICE_CHECK_EVOLVE" },
          { "open_dialogue": { "topic": "DIGIVICE_BATTLE_RESULT" } }
        ],
        "else": [
          { "set_string_var": "DEFEAT!", "target_var": { "u_val": "battle_result" } },
          { "set_string_var": "Your monster was defeated...", "target_var": { "u_val": "battle_msg" } },
          { "math": [ "n_battle_loss_streak = n_battle_loss_streak + 1" ] },
          {
            "if": { "math": [ "n_battle_loss_streak >= 3" ] },
            "then": [
              { "math": [ "n_care_mistakes = n_care_mistakes + 1" ] },
              { "math": [ "n_battle_loss_streak = 0" ] },
              { "u_message": "Your pet is getting discouraged from losing...", "type": "bad" }
            ]
          },
          {
            "u_run_inv_eocs": "all",
            "search_data": [
              { "condition": { "math": [ "n_pet_uid == u_selected_pet_uid" ] } }
            ],
            "true_eocs": [
              {
                "id": "EOC_DIGIVICE_BATTLE_STATS_DECREASE",
                "effect": [
                  { "math": [ "n_pet_hunger = max(n_pet_hunger - 10, 0)" ] },
                  { "math": [ "n_pet_happiness = max(n_pet_happiness - 15, 0)" ] },
                  { "math": [ "u_pet_hunger = n_pet_hunger" ] },
                  { "math": [ "u_pet_happiness = n_pet_happiness" ] }
                ]
              }
            ]
          },
          { "open_dialogue": { "topic": "DIGIVICE_BATTLE_RESULT" } }
        ]
      }
    ]
  }
]