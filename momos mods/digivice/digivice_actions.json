[
  {
    "type": "effect_on_condition",
    "id": "EOC_DIGIVICE_FLUSH",
    "effect": [
      {
        "u_run_inv_eocs": "all",
        "search_data": [
          {
            "condition": {
              "math": [
                "n_pet_uid == u_selected_pet_uid"
              ]
            }
          }
        ],
        "true_eocs": [
          {
            "id": "EOC_DIGIVICE_FLUSH_ITEM",
            "effect": [
              {
                "math": [
                  "n_mess_count = 0"
                ]
              },
              {
                "math": [
                  "n_potty_timer = 2"
                ]
              },
              {
                "math": [
                  "u_pet_mess_count = n_mess_count"
                ]
              },
              {
                "u_message": "You clean up after your digital pet. It looks relieved!",
                "type": "good"
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_DIGIVICE_TRAIN_ATK",
    "effect": [
      {
        "u_run_inv_eocs": "all",
        "search_data": [
          {
            "condition": {
              "math": [
                "n_pet_uid == u_selected_pet_uid"
              ]
            }
          }
        ],
        "true_eocs": [
          {
            "id": "EOC_DIGIVICE_TRAIN_ATK_ITEM",
            "effect": [
              {
                "if": { "math": [ "n_stamina < 20" ] },
                "then": [
                  { "u_message": "Your pet is too tired to train! Wait for stamina to regenerate.", "type": "bad" },
                  { "open_dialogue": { "topic": "DIGIVICE_BATTLE_MENU" } }
                ],
                "else": [
                  { "math": [ "n_pet_atk = n_pet_atk + 1" ] },
                  { "math": [ "n_pet_hunger = n_pet_hunger - 10" ] },
                  { "math": [ "n_pet_hunger = clamp(n_pet_hunger, 0, 100)" ] },
                  { "math": [ "u_pet_atk = n_pet_atk" ] },
                  { "math": [ "n_stamina = max(n_stamina - 10, 0)" ] },
                  { "math": [ "u_pet_stamina = n_stamina" ] },
                  { "math": [ "n_pet_weight = max(n_pet_weight - 1, 0)" ] },
                  { "run_eocs": "EOC_DIGIVICE_GET_HUNGER_STATUS" },
                  {
                    "set_string_var": "Your monster's attack increased! (ATK: <u_val:pet_atk>)",
                    "target_var": { "u_val": "train_msg" },
                    "parse_tags": true
                  },
                  { "u_message": { "u_val": "train_msg" } }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
