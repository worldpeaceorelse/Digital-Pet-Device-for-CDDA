{
  "type": "effect_on_condition",
  "id": "EOC_DIGIVICE_CHECK_EVOLVE",
  "effect": [
    {
      "u_run_inv_eocs": "random",
      "search_data": [ { "flags": [ "DIGIVICE_BABY" ] } ],
      "true_eocs": [ "EOC_DIGIVICE_CHECK_EVOLVE_BRANCH" ],
      "false_eocs": [ "EOC_DIGIVICE_NO_BABY_FOR_CHECK" ]
    }
  ]
},
{
  "type": "effect_on_condition",
  "id": "EOC_DIGIVICE_CHECK_EVOLVE_BRANCH",
  "effect": [
    {
      "if": { "math": [ "n_pet_stage < 5" ] },
      "then": [
        { "math": [ "n_pet_evolve_progress = n_pet_evolve_progress + 1" ] },
        {
          "if": {
            "and": [
              { "math": [ "n_pet_hunger >= 70" ] },
              { "math": [ "n_pet_happiness >= 70" ] }
            ]
          },
          "then": { "math": [ "n_pet_evolve_progress = n_pet_evolve_progress + 2" ] }
        },
        {
          "if": {
            "or": [
              { "math": [ "n_pet_hunger < 10" ] },
              { "math": [ "n_pet_happiness < 10" ] }
            ]
          },
          "then": { "math": [ "n_pet_evolve_progress = n_pet_evolve_progress - 1" ] }
        },
        { "math": [ "n_pet_evolve_progress = max(n_pet_evolve_progress, 0)" ] },
        {
          "if": { "math": [ "n_pet_evolve_progress >= 100" ] },
          "then": [
            { "math": [ "n_pet_stage = n_pet_stage + 1" ] },
            { "math": [ "n_pet_evolve_progress = 0" ] },
            {
              "if": { "math": [ "n_pet_stage < 5" ] },
              "then": [
                { "u_message": "Your digital pet is growing stronger!", "type": "good" }
              ],
              "else": { "run_eocs": "EOC_DIGIVICE_TYPE_DISTRIBUTOR", "beta_talker": "npc" }
            }
          ]
        }
      ]
    }
  ]
},
